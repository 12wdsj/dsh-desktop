{
  "name": "dsh-desktop",
  "version": "1.0.8",
  "description": "DeepSeek Harness Desktop - 蓝色小鲸鱼",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "author": "DeepSeek Harness Desktop",
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.deepseek.dsh-desktop",
    "productName": "DSH Desktop",
    "publish": [
      {
        "provider": "github",
        "owner": "12wdsj",
        "repo": "dsh-desktop"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "DSH-Desktop-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DSH Desktop"
    },
    "files": [
      "main.js",
      "preload.js",
      "pet.html",
      "assets/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}